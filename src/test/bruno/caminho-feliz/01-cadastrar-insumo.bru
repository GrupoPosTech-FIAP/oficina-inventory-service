meta {
  name: 01 - Cadastrar Insumo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/insumos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "{{insumoNome}}",
    "precoUnitario": 45.90,
    "estoqueAtual": 20,
    "estoqueMinimo": 5,
    "unidade": "L"
  }
}

script:pre-request {
  const sufixo = Math.floor(1000 + Math.random() * 9000);
  bru.setEnvVar("insumoNome", `Óleo Sintético 5W30 #${sufixo}`);
}

script:post-response {
  const resBody = res.getBody();
  if (resBody && resBody.id) {
    bru.setEnvVar("insumoId", String(resBody.id));
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.estoqueAtual: eq 20
  res.body.ativo: eq true
}

