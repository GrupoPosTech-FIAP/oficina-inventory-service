meta {
  name: 06 - Baixar Estoque em Lote (OS)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/insumos/baixa
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "insumoId": "{{insumoId}}",
        "quantidade": 32
      }
    ]
  }
}

assert {
  res.status: eq 204
}

