meta {
  name: 07 - Estornar Estoque em Lote (Rollback SAGA)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/insumos/estorno
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "insumoId": "{{insumoId}}",
        "quantidade": 2
      }
    ]
  }
}

assert {
  res.status: eq 204
}

